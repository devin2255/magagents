# MAGAgents - LLM API keys (copy to .env and fill in what you use)
# Leave a provider blank to skip it. If ALL are blank, MAGAgents runs in
# offline "template simulation" mode automatically (demo & tests still work).

# Global switch: auto | on | off
# auto = use LLM when keys exist; on = require keys (error if missing); off = force template mode
MAGAGENTS_LLM_ENABLED=auto

# --- Providers (only fill what you use) ---
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_API_KEY=local            # any non-empty value if using a local OpenAI-compatible server

# --- Optional per-agent overrides (uppercase agent id) ---
# MAGAGENTS_AGENT_TRUMP_PRESIDENT_PROVIDER=anthropic
# MAGAGENTS_AGENT_TRUMP_PRESIDENT_MODEL=claude-sonnet-4-5
